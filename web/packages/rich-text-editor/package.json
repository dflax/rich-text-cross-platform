{
  "name": "@rich-text-cross-platform/editor",
  "version": "0.1.1",
  "description": "A Quill-based rich-text editor enforcing the same small vocabulary and Delta format the Swift RichTextEditor package uses, for cross-platform-consistent documents.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "quill": "^2.0.2",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "jsdom": "^25.0.1",
    "quill": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "vitest": "^5.0.0"
  }
}
